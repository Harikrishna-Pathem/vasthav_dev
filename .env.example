# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL. Use a distinct database and credentials in test/production.
DATABASE_URL=postgresql://vasthav:vasthav@localhost:5432/vasthav?schema=public

# Security: set a strong value through your deployment secret manager in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
